{
  "name": "toso",
  "version": "0.1.0",
  "private": true,
  "description": "Free, local, Arabic-first prompt optimizer: cut token usage, then drive your CLI coding agents from one screen.",
  "license": "MIT",
  "author": "khaledaalharbi",
  "keywords": [
    "prompt-optimizer",
    "tokens",
    "arabic",
    "cli-agents",
    "gemini",
    "claude-code",
    "codex",
    "nextjs"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "bridge": "node bin/toso-bridge.mjs",
    "dev:all": "node bin/dev-all.mjs",
    "start:all": "node bin/dev-all.mjs --prod"
  },
  "bin": {
    "toso-bridge": "./bin/toso-bridge.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "node-pty": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/headless": "6.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
