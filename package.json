{
  "name": "toso",
  "version": "0.1.0",
  "private": true,
  "description": "Free, local, Arabic-first prompt optimizer: cut token usage, then drive your CLI coding agents from one screen.",
  "license": "MIT",
  "author": "khaledaalharbi",
  "keywords": [
    "prompt-optimizer",
    "tokens",
    "arabic",
    "cli-agents",
    "gemini",
    "claude-code",
    "codex",
    "nextjs"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "bridge": "node bin/toso-bridge.mjs",
    "dev:all": "node bin/dev-all.mjs",
    "start:all": "node bin/dev-all.mjs --prod"
  },
  "bin": {
    "toso-bridge": "./bin/toso-bridge.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "node-pty": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xterm/headless": "6.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
